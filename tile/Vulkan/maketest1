VULKAN_SDK_PATH = /Users/rangaswamypv/VulkanSDK/1.4.363.0/macOS

CFLAGS = -std=c++17 -O2 -I$(VULKAN_SDK_PATH)/include -I/opt/homebrew/include
LDFLAGS = -L$(VULKAN_SDK_PATH)/lib -L/opt/homebrew/lib \
          -lglfw -lvulkan -Wl,-rpath,$(VULKAN_SDK_PATH)/lib

VulkanTest: tria.cpp
	clang++ $(CFLAGS) -o VulkanTest tria.cpp $(LDFLAGS)

.PHONY: test clean

test: VulkanTest
	VK_ICD_FILENAMES=$(VULKAN_SDK_PATH)/share/vulkan/icd.d/MoltenVK_icd.json \
	VK_LAYER_PATH=$(VULKAN_SDK_PATH)/share/vulkan/explicit_layer.d \
	./VulkanTest

clean:
	rm -f VulkanTest
